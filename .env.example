# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development

# --- Database ---------------------------------------------------------------
# Local (host) access. docker compose overrides this for the api container.
DATABASE_URL=postgresql+psycopg://ragforge:ragforge@localhost:5434/ragforge
POSTGRES_USER=ragforge
POSTGRES_PASSWORD=ragforge
POSTGRES_DB=ragforge
POSTGRES_HOST_PORT=5434

# --- Strategy ---------------------------------------------------------------
# baseline | dense | bm25 | hybrid | hybrid_rerank | hybrid_rerank_rewrite | corrective | self_rag | adaptive
RAG_STRATEGY=adaptive
TOP_K=10
RETRIEVAL_CANDIDATES=50
SIMILARITY_METRIC=cosine

ENABLE_BM25=true
ENABLE_RERANKER=true
ENABLE_PARENT_CHILD=true
ENABLE_QUERY_REWRITE=true
ENABLE_MULTI_QUERY=false

# --- Fusion -----------------------------------------------------------------
FUSION_METHOD=rrf
DENSE_WEIGHT=0.5
BM25_WEIGHT=0.5
RRF_K=60

# --- Reranker ---------------------------------------------------------------
RERANKER_MODEL=BAAI/bge-reranker-base
RERANK_CANDIDATES=30
RERANK_TOP_K=5

# --- Embeddings -------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
EMBEDDING_DEVICE=cpu

# --- Chunking (approximate tokens) ------------------------------------------
CHILD_CHUNK_SIZE=400
CHILD_CHUNK_OVERLAP=60
PARENT_CHUNK_SIZE=1600

# --- Adaptive / corrective thresholds ---------------------------------------
RELEVANCE_THRESHOLD=0.65
EVIDENCE_THRESHOLD=0.70
FAITHFULNESS_THRESHOLD=0.80
MAX_CORRECTIVE_ITERATIONS=2
MAX_SELF_RAG_ITERATIONS=2
MAX_REGENERATIONS=1

# --- LLM --------------------------------------------------------------------
# anthropic | openai_compatible | fake
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
LLM_FAST_MODEL=claude-haiku-4-5-20251001
JUDGE_MODEL=claude-sonnet-5
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=3
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=http://localhost:11434/v1   # e.g. Ollama

# --- Observability ----------------------------------------------------------
ENABLE_LANGFUSE=false
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
LOG_LEVEL=INFO
LOG_JSON=false
