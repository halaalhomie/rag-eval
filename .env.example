# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development

# --- Database ---------------------------------------------------------------
# Local (host) access. docker compose overrides this for the api container.
DATABASE_URL=postgresql+psycopg://ragforge:ragforge@localhost:5434/ragforge
POSTGRES_USER=ragforge
POSTGRES_PASSWORD=ragforge
POSTGRES_DB=ragforge
POSTGRES_HOST_PORT=5434

# --- Strategy ---------------------------------------------------------------
# baseline | dense | bm25 | hybrid | hybrid_rerank | hybrid_rerank_rewrite | corrective | self_rag | adaptive
RAG_STRATEGY=baseline
TOP_K=10
RETRIEVAL_CANDIDATES=50
SIMILARITY_METRIC=cosine

ENABLE_BM25=true
ENABLE_RERANKER=true
ENABLE_PARENT_CHILD=true
ENABLE_QUERY_REWRITE=true
ENABLE_MULTI_QUERY=false

# --- Fusion -----------------------------------------------------------------
FUSION_METHOD=rrf
DENSE_WEIGHT=0.5
BM25_WEIGHT=0.5
RRF_K=60

# --- Reranker ---------------------------------------------------------------
RERANKER_MODEL=BAAI/bge-reranker-base
RERANK_CANDIDATES=30
RERANK_TOP_K=5

# --- Embeddings -------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
EMBEDDING_DEVICE=cpu

# --- Chunking (approximate tokens) ------------------------------------------
CHILD_CHUNK_SIZE=360
CHILD_CHUNK_OVERLAP=60
PARENT_CHUNK_SIZE=1600

# --- Adaptive / corrective thresholds ---------------------------------------
RELEVANCE_THRESHOLD=0.65
EVIDENCE_THRESHOLD=0.70
FAITHFULNESS_THRESHOLD=0.80
MAX_CORRECTIVE_ITERATIONS=2
MAX_SELF_RAG_ITERATIONS=2
MAX_REGENERATIONS=1

# --- LLM ---------------------------------------------------------------------
# openai_compatible | fake
# Default: local MLX server on the host (Apple Silicon), started with
#   mlx_lm.server --model mlx-community/Qwen2.5-3B-Instruct-4bit --port 8080
# Swap to any OpenAI-compatible endpoint (Ollama, vLLM, OpenAI, Groq, Gemini, HF) by
# changing the three lines below. Inside docker compose the base URL is overridden to
# http://host.docker.internal:8080/v1.
LLM_PROVIDER=openai_compatible
OPENAI_BASE_URL=http://localhost:8080/v1
LLM_MODEL=mlx-community/Qwen2.5-3B-Instruct-4bit
LLM_FAST_MODEL=mlx-community/Qwen2.5-3B-Instruct-4bit
JUDGE_MODEL=mlx-community/Qwen2.5-3B-Instruct-4bit
# OPENAI_API_KEY=              # only for hosted providers
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=3
# USD per 1M tokens, {"model": [input, output]}. Unlisted, non-local models are reported
# as "unpriced" instead of $0.
# LLM_PRICING={"my-hosted-model": [0.50, 1.50]}

# --- Observability ----------------------------------------------------------
ENABLE_LANGFUSE=false
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
LOG_LEVEL=INFO
LOG_JSON=false
